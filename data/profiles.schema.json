{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Into Things profiles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profiles"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "bio",
          "interests"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "bio": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "avatar": {
            "type": "string",
            "pattern": "^assets/avatars/[a-zA-Z0-9_-]+\\.(svg|png|jpe?g|webp)$"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                }
              }
            }
          },
          "interests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "answer"
              ],
              "properties": {
                "category": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "answer": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "url"
                    ],
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https?://"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
